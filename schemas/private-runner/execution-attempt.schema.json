{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExecutionAttempt",
  "type":"object","additionalProperties":false,
  "required":["schema","attempt_id","request_id","profile_id","source_sha","source_tree","worktree_id","task_root_id","evidence_root_id","started_at","state"],
