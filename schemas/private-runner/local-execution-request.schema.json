{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"LocalExecutionRequest",
  "type":"object","additionalProperties":false,
  "required":["schema","request_id","repository_full_name","profile_id","profile_sha256","source_sha","source_tree","fresh_attempt_required","allowed_paths","allowed_commands","network_allowlist","material_manifest_sha256","protected_registry_sha256","claim_ceiling"],
  "properties":{
    "schema":{"const":"parent-pm.local-execution-request.v1"},"request_id":{"type":"string","minLength":8},"repository_full_name":{"type":"string"},"profile_id":{"type":"string"},"profile_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "fresh_attempt_required":{"const":true},"allowed_paths":{"type":"array","items":{"type":"string"}},"allowed_commands":{"type":"array","minItems":1,"items":{"type":"string"}},
    "network_allowlist":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"material_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"protected_registry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "claim_ceiling":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["EXECUTOR_SOURCE","EXECUTOR_TEST","EXECUTOR_BUILD","EXECUTOR_LOCAL_RUNTIME"]}}
  }
}
