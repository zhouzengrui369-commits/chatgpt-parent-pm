{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouzengrui369-commits/chatgpt-parent-pm/schemas/ecosystem-v03-adoption.schema.json",
  "title": "Parent PM ecosystem v0.3 adoption record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "program_id",
    "fixture",
    "ecosystem",
    "shared_knowledge_engine",
    "product",
    "activation",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "const": "ECOSYSTEM_V03_ADOPTION"
    },
    "program_id": {
      "const": "PARENT-PM-ECOSYSTEM-V03-R1"
    },
    "fixture": {
      "type": "boolean"
    },
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "version",
        "status",
        "blueprint_path",
        "blueprint_blob_sha",
        "blueprint_sha256"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repo"
        },
        "commit": {
          "$ref": "#/$defs/sha40"
        },
        "version": {
          "const": "0.3.0"
        },
        "status": {
          "enum": [
            "PROPOSED",
            "HUMAN_OWNER_ACCEPTED"
          ]
        },
        "blueprint_path": {
          "$ref": "#/$defs/nonempty"
        },
        "blueprint_blob_sha": {
          "$ref": "#/$defs/sha40"
        },
        "blueprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "shared_knowledge_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "supported_capabilities",
        "contract"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "supported_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "knowledge_object",
              "provenance",
              "ingestion",
              "retrieval",
              "review",
              "permission",
              "agent_access",
              "sync_portability",
              "security",
              "feedback"
            ]
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_commit",
            "manifest_path",
            "contract_manifest_sha256",
            "schema_path",
            "schema_sha256",
            "positive_fixture_sha256",
            "negative_manifest_sha256",
            "conformance_receipt_path",
            "conformance_receipt_sha256",
            "workflow_run_id"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/semver"
            },
            "source_commit": {
              "$ref": "#/$defs/sha40"
            },
            "manifest_path": {
              "$ref": "#/$defs/nonempty"
            },
            "contract_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "schema_path": {
              "$ref": "#/$defs/nonempty"
            },
            "schema_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "positive_fixture_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "negative_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "conformance_receipt_path": {
              "$ref": "#/$defs/nonempty"
            },
            "conformance_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "workflow_run_id": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "project_pm",
        "role",
        "current_protected_goal",
        "current_candidate_sha",
        "migration_state",
        "local_goal_id",
        "deviations"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repo"
        },
        "project_pm": {
          "$ref": "#/$defs/nonempty"
        },
        "role": {
          "enum": [
            "DIGITAL_TWIN_PRODUCT",
            "REFERENCE_IMPLEMENTATION",
            "SCENARIO_PRODUCT",
            "DOMAIN_PRODUCT",
            "CONTENT_PRODUCT"
          ]
        },
        "current_protected_goal": {
          "$ref": "#/$defs/nonempty"
        },
        "current_candidate_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha40"
            },
            {
              "type": "null"
            }
          ]
        },
        "migration_state": {
          "enum": [
            "QUEUED",
            "ACTIVATED",
            "IMPLEMENTING",
            "CANDIDATE",
            "ACCEPTED",
            "BLOCKED",
            "QUEUED_OPTIONAL",
            "NOT_ACTIVATED_NO_CUSTOMER_VALUE"
          ]
        },
        "local_goal_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "task_root",
        "scope",
        "non_goals"
      ],
      "properties": {
        "state": {
          "enum": [
            "PLANNED",
            "ACTIVATED"
          ]
        },
        "task_root": {
          "$ref": "#/$defs/nonempty"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    }
  }
}
