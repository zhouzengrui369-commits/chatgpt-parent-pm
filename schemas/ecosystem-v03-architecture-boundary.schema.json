{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouzengrui369-commits/chatgpt-parent-pm/schemas/ecosystem-v03-architecture-boundary.schema.json",
  "title": "Parent PM ecosystem v0.3 architecture boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "fixture",
    "product",
    "evaluation_date",
    "components",
    "physical_contract",
    "deviations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "const": "ECOSYSTEM_V03_ARCHITECTURE_BOUNDARY"
    },
    "fixture": {
      "type": "boolean"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "project_role",
        "adoption_role",
        "adoption_record_path"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repo"
        },
        "project_role": {
          "$ref": "#/$defs/nonempty"
        },
        "adoption_role": {
          "$ref": "#/$defs/nonempty"
        },
        "adoption_record_path": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "evaluation_date": {
      "type": "string",
      "format": "date"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "responsibility",
          "canonical_truth",
          "contract_surface",
          "namespace",
          "shared_capability",
          "deviation_id"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "responsibility": {
            "enum": [
              "SHARED_CONTRACT_ADAPTER",
              "DOMAIN_EXTENSION",
              "PRODUCT_POLICY",
              "VIEW_PROJECTION",
              "PHYSICAL_STORAGE"
            ]
          },
          "canonical_truth": {
            "type": "boolean"
          },
          "contract_surface": {
            "type": "boolean"
          },
          "namespace": {
            "$ref": "#/$defs/nonempty"
          },
          "shared_capability": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonempty"
              },
              {
                "type": "null"
              }
            ]
          },
          "deviation_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonempty"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "physical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_physical_schema",
        "public_interfaces",
        "physical_identifiers"
      ],
      "properties": {
        "exposes_physical_schema": {
          "type": "boolean"
        },
        "public_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "physical_identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "status",
          "owner",
          "expires_on",
          "reason",
          "interoperability_plan",
          "migration_plan",
          "security_impact"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonempty"
          },
          "path": {
            "$ref": "#/$defs/nonempty"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "const": "ACCEPTED"
          },
          "owner": {
            "$ref": "#/$defs/nonempty"
          },
          "expires_on": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "$ref": "#/$defs/nonempty"
          },
          "interoperability_plan": {
            "$ref": "#/$defs/nonempty"
          },
          "migration_plan": {
            "$ref": "#/$defs/nonempty"
          },
          "security_impact": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    }
  }
}
